# Copie para .env e preencha (o .env não vai para o Git). Depois: npm run setup
# O que ficar vazio é perguntado na hora.

# Supabase > Project Settings > Database > Connection string > URI (com a senha do banco)
DATABASE_URL=

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Login do painel. A service_role key só é usada para CRIAR o usuário
# (se ele ainda não existir) — nunca vai para o site.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
